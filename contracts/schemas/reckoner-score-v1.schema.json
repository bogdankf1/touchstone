{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchstone.example/contracts/reckoner-score-v1.schema.json",
  "title": "Reckoner score v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "run_id",
    "task_id",
    "call_id",
    "raw_probability",
    "distribution",
    "confidence",
    "requested_model",
    "reported_model",
    "question_version",
    "input_sha256",
    "usage",
    "cost",
    "attempt_status",
    "adjusted_probability",
    "calibration_id"
  ],
  "properties": {
    "schema_version": {
      "const": "reckoner-score-v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_probability": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "distribution": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fraud",
            "legitimate"
          ],
          "properties": {
            "fraud": {
              "type": "string",
              "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
            },
            "legitimate": {
              "type": "string",
              "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_model": {
      "const": "jev-1.13.0"
    },
    "reported_model": {
      "anyOf": [
        {
          "const": "jev-1.13.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "question_version": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "amount",
        "currency",
        "price_table_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "settled",
            "uncertain",
            "unavailable"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "const": "USD"
        },
        "price_table_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "attempt_status": {
      "enum": [
        "responded",
        "failed",
        "uncertain"
      ]
    },
    "adjusted_probability": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "calibration_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
