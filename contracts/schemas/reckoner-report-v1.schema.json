{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchstone.example/contracts/reckoner-report-v1.schema.json",
  "title": "Reckoner deterministic run report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_version",
    "run",
    "counts",
    "aggregate",
    "per_tenant",
    "evaluation_errors",
    "exports",
    "caveats"
  ],
  "properties": {
    "schema_version": { "const": "reckoner-report-v1" },
    "report_version": { "const": "1" },
    "run": { "$ref": "#/$defs/run" },
    "counts": { "$ref": "#/$defs/counts" },
    "aggregate": { "$ref": "#/$defs/metric_set" },
    "per_tenant": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/metric_set" }
    },
    "evaluation_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/evaluation_error" }
    },
    "exports": {
      "type": "array",
      "items": { "$ref": "#/$defs/export_reference" }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "nullable_nonempty": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonempty" }]
    },
    "nonnegative_decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "nullable_nonnegative_decimal": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonnegative_decimal" }]
    },
    "id_map": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nonempty" }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "purpose",
        "status",
        "execution_mode",
        "provider_call_mode",
        "config_id",
        "bundle_id",
        "prompt_version",
        "model",
        "price_table_version",
        "threshold_config_ids",
        "cohort_ids",
        "code_revision",
        "created_at",
        "preflight_at"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/nonempty" },
        "purpose": { "enum": ["pilot", "baseline"] },
        "status": { "enum": ["pending", "running", "complete", "incomplete", "blocked"] },
        "execution_mode": { "enum": ["paid", "test"] },
        "provider_call_mode": {
          "oneOf": [{ "type": "null" }, { "enum": ["fake", "measured"] }]
        },
        "config_id": { "$ref": "#/$defs/nonempty" },
        "bundle_id": { "$ref": "#/$defs/nonempty" },
        "prompt_version": { "$ref": "#/$defs/nonempty" },
        "model": { "$ref": "#/$defs/nonempty" },
        "price_table_version": { "$ref": "#/$defs/nonempty" },
        "threshold_config_ids": { "$ref": "#/$defs/id_map" },
        "cohort_ids": { "$ref": "#/$defs/id_map" },
        "code_revision": { "$ref": "#/$defs/nullable_nonempty" },
        "created_at": { "type": "string", "format": "date-time" },
        "preflight_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "completed",
        "failed",
        "uncertain",
        "pending",
        "dispatched",
        "evaluation_errors"
      ],
      "properties": {
        "expected": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "uncertain": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "dispatched": { "type": "integer", "minimum": 0 },
        "evaluation_errors": { "type": "integer", "minimum": 0 }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "value": { "$ref": "#/$defs/nullable_nonnegative_decimal" }
      }
    },
    "suite_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value", "status"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "value": { "$ref": "#/$defs/nullable_nonnegative_decimal" },
        "status": { "enum": ["pass", "fail", "error"] }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "review",
        "error",
        "total",
        "currency",
        "unknown_provider_costs",
        "reserved_unsettled"
      ],
      "properties": {
        "model": { "$ref": "#/$defs/nonnegative_decimal" },
        "review": { "$ref": "#/$defs/nonnegative_decimal" },
        "error": { "$ref": "#/$defs/nonnegative_decimal" },
        "total": { "$ref": "#/$defs/nonnegative_decimal" },
        "currency": { "const": "USD" },
        "unknown_provider_costs": { "type": "integer", "minimum": 0 },
        "reserved_unsettled": { "$ref": "#/$defs/nonnegative_decimal" }
      }
    },
    "cpst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value", "currency", "availability"],
      "properties": {
        "numerator": { "$ref": "#/$defs/nullable_nonnegative_decimal" },
        "denominator": { "type": "integer", "minimum": 0 },
        "value": { "$ref": "#/$defs/nullable_nonnegative_decimal" },
        "currency": { "const": "USD" },
        "availability": {
          "enum": [
            "available",
            "unknown_provider_cost",
            "incomplete_outcomes",
            "no_correct_outcomes"
          ]
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "p99_nearest_rank"],
      "properties": {
        "population": { "type": "integer", "minimum": 0 },
        "p99_nearest_rank": { "$ref": "#/$defs/nullable_nonnegative_decimal" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "false_positive_rate",
        "missed_fraud_rate",
        "escalation_rate",
        "completion_rate",
        "response_schema_validity",
        "required_suite_pass_rate",
        "costs",
        "cpst",
        "latency_ms"
      ],
      "properties": {
        "correctness": { "$ref": "#/$defs/rate" },
        "false_positive_rate": { "$ref": "#/$defs/rate" },
        "missed_fraud_rate": { "$ref": "#/$defs/rate" },
        "escalation_rate": { "$ref": "#/$defs/rate" },
        "completion_rate": { "$ref": "#/$defs/rate" },
        "response_schema_validity": { "$ref": "#/$defs/rate" },
        "required_suite_pass_rate": { "$ref": "#/$defs/suite_rate" },
        "costs": { "$ref": "#/$defs/costs" },
        "cpst": { "$ref": "#/$defs/cpst" },
        "latency_ms": { "$ref": "#/$defs/latency" }
      }
    },
    "metric_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics"],
      "properties": { "metrics": { "$ref": "#/$defs/metrics" } }
    },
    "evaluation_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "task_id", "errors"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/nonempty" },
        "task_id": { "$ref": "#/$defs/nonempty" },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "export_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "status", "event_id", "task_id"],
      "properties": {
        "producer": { "enum": ["runner", "evaluator"] },
        "status": { "enum": ["pending", "exported", "failed"] },
        "event_id": { "$ref": "#/$defs/nonempty" },
        "task_id": { "$ref": "#/$defs/nonempty" }
      }
    }
  }
}
