{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchstone.example/contracts/reckoner-case-note-v1.schema.json",
  "title": "Reckoner case-note v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "note_id",
    "case_id",
    "decision_id",
    "prompt_version",
    "requested_model",
    "reported_model",
    "generation_status",
    "evidence_id",
    "call_id",
    "started_at",
    "completed_at",
    "verdict_recommendation",
    "confidence",
    "risk_indicators",
    "entity_neighbourhood",
    "comparable_cases",
    "what_would_change_verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "reckoner-case-note-v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "note_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "requested_model": {
      "const": "anthropic/claude-haiku-4-5-20251001"
    },
    "reported_model": {
      "anyOf": [
        {
          "const": "anthropic/claude-haiku-4-5-20251001"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation_status": {
      "enum": [
        "succeeded",
        "failed",
        "degraded"
      ]
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "call_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict_recommendation": {
      "enum": [
        "approve",
        "decline"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "meaning"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "meaning": {
          "enum": [
            "jev_distribution_concentration",
            "raw_choice_probability",
            "calibrated_fraud_probability",
            "unavailable"
          ]
        }
      }
    },
    "risk_indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "indicator_id",
          "description",
          "method",
          "evidence_refs"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "indicator_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_ref_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_refs_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_refs_truncated": {
            "type": "boolean"
          }
        },
        "dependentRequired": {
          "evidence_ref_count": [
            "evidence_refs_sha256",
            "evidence_refs_truncated"
          ],
          "evidence_refs_sha256": [
            "evidence_ref_count",
            "evidence_refs_truncated"
          ],
          "evidence_refs_truncated": [
            "evidence_ref_count",
            "evidence_refs_sha256"
          ]
        }
      },
      "minItems": 0,
      "maxItems": 3
    },
    "entity_neighbourhood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "comparable_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transaction_id",
          "summary",
          "evidence_refs"
        ],
        "properties": {
          "transaction_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    },
    "what_would_change_verdict": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "evidence_refs"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    }
  }
}
