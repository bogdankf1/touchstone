{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchstone.example/contracts/oracle-v1.schema.json",
  "title": "Simulated transaction oracle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "transaction_id",
    "label",
    "oracle_version",
    "source_file_sha256",
    "source_record"
  ],
  "properties": {
    "schema_version": { "const": "oracle-v1" },
    "tenant_id": { "$ref": "#/$defs/nonempty" },
    "transaction_id": { "$ref": "#/$defs/nonempty" },
    "label": { "enum": ["legitimate", "fraud"] },
    "oracle_version": { "$ref": "#/$defs/nonempty" },
    "source_file_sha256": { "$ref": "#/$defs/sha256" },
    "source_record": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
