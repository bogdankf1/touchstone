{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchstone.example/contracts/run-declaration-v1.schema.json",
  "title": "Generic workflow run declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "tenant_id", "workflow_id", "workflow_version",
    "run_id", "declared_at", "expected_task_count", "expected_task_ids",
    "experiment_version", "cohort_version", "config_version", "code_revision",
    "dataset_version", "measurement_mode", "dataset_simulated", "replay",
    "evaluation_suites"
  ],
  "properties": {
    "schema_version": { "const": "run-declaration-v1" },
    "lifecycle_version": { "const": "root-work-v1" },
    "provider_prices": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "price_table_version"], "properties": {"provider": {"$ref": "#/$defs/nonempty"}, "model": {"$ref": "#/$defs/nonempty"}, "price_table_version": {"$ref": "#/$defs/nonempty"}}}},
    "comparison": {"type":"object","additionalProperties":false,"required":["reference_version","business_config_id","arm"],"properties":{"reference_version":{"$ref":"#/$defs/nonempty"},"business_config_id":{"$ref":"#/$defs/nonempty"},"arm":{"type":"object","additionalProperties":false,"required":["config_version","model_version","prompt_version","question_version","calibration_id","evidence_version","retrieval_window","execution_mode","call_ids"],"properties":{"config_version":{"$ref":"#/$defs/nonempty"},"model_version":{"$ref":"#/$defs/nonempty"},"prompt_version":{"$ref":"#/$defs/nonempty"},"question_version":{"$ref":"#/$defs/nonempty"},"calibration_id":{"$ref":"#/$defs/nonempty"},"evidence_version":{"$ref":"#/$defs/nonempty"},"retrieval_window":{"$ref":"#/$defs/nonempty"},"execution_mode":{"$ref":"#/$defs/nonempty"},"call_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/nonempty"}}}}}},
    "event_id": { "$ref": "#/$defs/nonempty" },
    "tenant_id": { "$ref": "#/$defs/nonempty" },
    "workflow_id": { "$ref": "#/$defs/nonempty" },
    "workflow_version": { "$ref": "#/$defs/nonempty" },
    "run_id": { "$ref": "#/$defs/nonempty" },
    "declared_at": { "type": "string", "format": "date-time" },
    "expected_task_count": { "type": "integer", "minimum": 1 },
    "expected_task_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "experiment_version": { "$ref": "#/$defs/nonempty" },
    "cohort_version": { "$ref": "#/$defs/nonempty" },
    "config_version": { "$ref": "#/$defs/nonempty" },
    "code_revision": { "$ref": "#/$defs/nonempty" },
    "dataset_version": { "$ref": "#/$defs/nonempty" },
    "measurement_mode": { "enum": ["measured", "fabricated"] },
    "dataset_simulated": { "type": "boolean" },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["is_replay", "source_manifest_sha256"],
      "properties": {
        "is_replay": { "type": "boolean" },
        "source_manifest_sha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        }
      },
      "if": { "properties": { "is_replay": { "const": true } } },
      "then": { "properties": { "source_manifest_sha256": { "type": "string" } } },
      "else": { "properties": { "source_manifest_sha256": { "type": "null" } } }
    },
    "evaluation_suites": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["suite_id", "suite_version", "expected_case_ids", "required_checks"],
        "properties": {
          "suite_id": { "$ref": "#/$defs/nonempty" },
          "suite_version": { "$ref": "#/$defs/nonempty" },
          "expected_case_ids": {
            "type": "array", "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonempty" }
          },
          "required_checks": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "metric_expectations": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric_id", "definition_version", "unit", "expected_task_ids"],
        "properties": {
          "metric_id": { "$ref": "#/$defs/nonempty" },
          "definition_version": { "$ref": "#/$defs/nonempty" },
          "unit": { "$ref": "#/$defs/nonempty" },
          "expected_task_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 }
  }
}
