FROM ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c AS uv

FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS build
COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY platform/ platform/
COPY contracts/schemas/ contracts/schemas/
COPY workloads/reckoner/pyproject.toml workloads/reckoner/pyproject.toml
COPY workloads/synthetic/pyproject.toml workloads/synthetic/pyproject.toml
RUN uv build --wheel --package touchstone-platform --out-dir /tmp/wheels && \
    uv venv /opt/venv && \
    uv pip install --python /opt/venv/bin/python /tmp/wheels/touchstone_platform-*.whl && \
    /opt/venv/bin/dbt deps --project-dir /app/platform/dbt

FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app/platform/dbt /app/platform/dbt
RUN mkdir -p /app/platform/dbt/target /home/touchstone && \
    chown -R 10001:10001 /app/platform/dbt/target /home/touchstone
ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/home/touchstone \
    PYTHONUNBUFFERED=1 \
    TOUCHSTONE_DBT_PROJECT=/app/platform/dbt
USER 10001:10001
EXPOSE 8000
CMD ["touchstone", "serve", "--host", "0.0.0.0", "--port", "8000"]
