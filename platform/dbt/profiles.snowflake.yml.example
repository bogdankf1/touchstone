touchstone:
  target: snowflake
  outputs:
    snowflake:
      type: snowflake
      account: "{{ env_var('TOUCHSTONE_SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('TOUCHSTONE_SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('TOUCHSTONE_SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      role: "{{ env_var('TOUCHSTONE_SNOWFLAKE_ROLE') }}"
      database: "{{ env_var('TOUCHSTONE_SNOWFLAKE_DATABASE') }}"
      warehouse: "{{ env_var('TOUCHSTONE_SNOWFLAKE_WAREHOUSE') }}"
      schema: "{{ env_var('TOUCHSTONE_SNOWFLAKE_SCHEMA') }}"
      threads: 2
